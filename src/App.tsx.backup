import React, { useState, useEffect } from 'react';
import { StoredRecommendation } from './lib/types';
import { getLastRecommendation } from './lib/storage';
import { sendMessage } from './lib/bus';

const App: React.FC = () => {
  const [lastRecommendation, setLastRecommendationState] = useState<StoredRecommendation | null>(null);
  const [isLoading, setIsLoading] = useState(true);

  useEffect(() => {
    loadLastRecommendation();
  }, []);

  const loadLastRecommendation = async () => {
    try {
      const recommendation = await getLastRecommendation();
      setLastRecommendationState(recommendation);
    } catch (error) {
      console.error('Failed to load last recommendation:', error);
    } finally {
      setIsLoading(false);
    }
  };

  const handleRunOnTab = async () => {
    try {
      await sendMessage({ type: "HARMONY_EVAL" });
      // Refresh the recommendation after running
      setTimeout(loadLastRecommendation, 1000);
    } catch (error) {
      console.error('Failed to run on tab:', error);
    }
  };

  if (isLoading) {
    return (
      <div className="w-full h-full flex items-center justify-center bg-gradient-to-br from-purple-600 to-blue-600">
        <div className="text-white text-center">
          <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-white mx-auto mb-4"></div>
          <p>Loading Harmony...</p>
        </div>
      </div>
    );
  }

  return (
    <div className="w-full h-full bg-gradient-to-br from-purple-600 to-blue-600 text-white">
      {/* Header */}
      <div className="p-6 pb-4">
        <div className="flex items-center justify-between">
          <div>
            <h1 className="text-2xl font-bold">Harmony</h1>
            <p className="text-purple-200 text-sm">Smart Credit Card Rewards</p>
          </div>
          <div className="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center">
            <span className="text-2xl">💳</span>
          </div>
        </div>
      </div>

      {/* Main Content */}
      <div className="px-6 pb-6 flex-1">
        {lastRecommendation ? (
          <div className="space-y-4">
            {/* Last Recommendation Card */}
            <div className="bg-white/10 backdrop-blur-sm rounded-xl p-4 border border-white/20">
              <div className="flex items-center justify-between mb-3">
                <h3 className="font-semibold">Last Recommendation</h3>
                <span className="text-xs bg-white/20 px-2 py-1 rounded-full">
                  {new Date(lastRecommendation.timestamp).toLocaleDateString()}
                </span>
              </div>
              
              <div className="space-y-3">
                <div className="flex items-center justify-between">
                  <span className="text-sm text-purple-200">Merchant</span>
                  <span className="font-medium">{lastRecommendation.context.merchantName}</span>
                </div>
                
                <div className="flex items-center justify-between">
                  <span className="text-sm text-purple-200">Amount</span>
                  <span className="font-medium">${lastRecommendation.context.amount.toFixed(2)}</span>
                </div>
                
                <div className="flex items-center justify-between">
                  <span className="text-sm text-purple-200">Best Card</span>
                  <span className="font-medium">{lastRecommendation.recommendation.card.displayName}</span>
                </div>
                
                <div className="flex items-center justify-between">
                  <span className="text-sm text-purple-200">Reward Rate</span>
                  <span className="font-medium text-green-300">
                    {(lastRecommendation.recommendation.effectiveRate * 100).toFixed(1)}%
                  </span>
                </div>
                
                <div className="flex items-center justify-between">
                  <span className="text-sm text-purple-200">Est. Rewards</span>
                  <span className="font-medium text-green-300">
                    ${lastRecommendation.recommendation.estimatedValue.toFixed(2)}
                  </span>
                </div>
              </div>
              
              <div className="mt-4 pt-3 border-t border-white/20">
                <div className="text-xs text-purple-200 mb-2">Why this card?</div>
                <div className="space-y-1">
                  {lastRecommendation.recommendation.rationale.map((reason, index) => (
                    <div key={index} className="text-xs text-purple-100">• {reason}</div>
                  ))}
                </div>
              </div>
            </div>

            {/* Action Button */}
            <button
              onClick={handleRunOnTab}
              className="w-full bg-white/20 hover:bg-white/30 backdrop-blur-sm rounded-xl p-4 border border-white/20 transition-all duration-200 flex items-center justify-center space-x-2"
            >
              <span>🔄</span>
              <span className="font-medium">Run on This Tab</span>
            </button>
          </div>
        ) : (
          <div className="text-center py-8">
            <div className="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-4">
              <span className="text-2xl">💳</span>
            </div>
            <h3 className="text-lg font-semibold mb-2">No Recommendations Yet</h3>
            <p className="text-purple-200 text-sm mb-4">
              Visit a supported merchant's checkout page to see your first recommendation.
            </p>
            <button
              onClick={handleRunOnTab}
              className="bg-white/20 hover:bg-white/30 backdrop-blur-sm rounded-xl px-6 py-3 border border-white/20 transition-all duration-200"
            >
              Try on Current Tab
            </button>
          </div>
        )}

        {/* Footer */}
        <div className="mt-6 pt-4 border-t border-white/20">
          <div className="flex items-center justify-between text-xs text-purple-200">
            <span>Supported Sites: Amazon, Uber Eats, etc.</span>
            <button className="hover:text-white transition-colors">
              Settings
            </button>
          </div>
        </div>
      </div>
    </div>
  );
};

export default App;
